{
  "name": "elenchus",
  "version": "0.0.0",
  "private": true,
  "description": "A stateless controller that reads one Kickoff 360 seat record per pass and says what the review needs next.",
  "type": "module",
  "bin": {
    "elenchus": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p harness --noEmit",
    "test": "vitest run",
    "harness:t4": "node --experimental-transform-types --import ./harness/register.mjs harness/t4.ts"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
